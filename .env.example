# =============================================================================
# Evoly v2 - variables d'environnement
# Copier en .env à la racine et renseigner. Ne jamais committer de vraie valeur.
# =============================================================================

# Base de données (PostgreSQL 16+)
DATABASE_URL="postgresql://evoly:evoly@localhost:5432/evoly"

# Authentification (Better Auth) - générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET="à-remplacer-par-au-moins-32-caractères"
BETTER_AUTH_URL="http://localhost:3001"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# Stripe - compte plateforme Evoly
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Deux points d'entrée signés distincts (RG-PAY-07)
STRIPE_WEBHOOK_SECRET_PLATFORM="whsec_..."
STRIPE_WEBHOOK_SECRET_CONNECT="whsec_..."
# Prix de l'abonnement Pro (euros)
STRIPE_PRICE_PRO_MONTHLY_EUR="price_..."
STRIPE_PRICE_PRO_YEARLY_EUR="price_..."

# E-mails (Resend). Sans clé, les e-mails sont écrits dans EMAIL_OUTBOX_DIR (développement, tests).
RESEND_API_KEY=""
EMAIL_OUTBOX_DIR="/tmp/evoly-outbox"
RESEND_WEBHOOK_SECRET=""
EMAIL_FROM_DOMAIN="evoly.me"

# Fichiers (Cloudflare R2)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="evoly-uploads"
R2_PUBLIC_URL=""
# Développement sans R2 : fichiers écrits dans ce dossier et servis par /files/…
UPLOADS_DIR=""
# Cible CNAME des domaines personnalisés (par défaut domains.<NEXT_PUBLIC_BASE_DOMAIN>)
CUSTOM_DOMAIN_TARGET=""
NEXT_PUBLIC_ASSETS_URL="https://assets.evoly.me"

# Domaines
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SCANNER_URL="http://localhost:3002"
NEXT_PUBLIC_BASE_DOMAIN="evoly.me"
CUSTOM_DOMAIN_TARGET="domains.evoly.me"

# Tâches planifiées et suivi d'erreurs
CRON_SECRET="à-remplacer"
SENTRY_DSN=""

# --- Relevés de commissions (émetteur) ---
EVOLY_LEGAL_NAME=Evoly Solutions
EVOLY_LEGAL_ADDRESS=Bruxelles, Belgique
EVOLY_VAT_NUMBER=

# Alertes au support d’Evoly (remboursement de vendeur impossible…)
SUPPORT_EMAIL=""
