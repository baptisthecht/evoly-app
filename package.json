{
  "name": "evoly",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @evoly/db generate",
    "db:migrate": "pnpm --filter @evoly/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @evoly/db migrate:deploy",
    "db:seed": "pnpm --filter @evoly/db seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "lint-staged": "^17.6.0",
    "prettier": "^3.6.2",
    "simple-git-hooks": "^2.14.0",
    "turbo": "^2.5.8",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/engines",
      "esbuild"
    ],
    "overrides": {
      "deepmerge-ts@<8.0.0": ">=8.0.0",
      "mysql2@<=3.23.0": ">=3.23.1",
      "source-map-js@<1.2.2": ">=1.2.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv"
      ]
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
