{
  "name": "evoly",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @evoly/db generate",
    "db:migrate": "pnpm --filter @evoly/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @evoly/db migrate:deploy",
    "db:seed": "pnpm --filter @evoly/db seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks",
    "traceability": "node ops/traceability.mjs"
  },
  "devDependencies": {
    "lint-staged": "^17.6.0",
    "prettier": "^3.6.2",
    "simple-git-hooks": "^2.14.0",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/engines",
      "esbuild"
    ],
    "overrides": {
      "deepmerge-ts@<8.0.0": ">=8.0.0",
      "fast-uri@<3.1.9": "3.1.9",
      "ip-address@<=10.7.3": "10.7.4",
      "mysql2@<=3.23.0": ">=3.23.1",
      "source-map-js@<1.2.2": ">=1.2.2",
      "vite": "^7.3.7"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv",
        "GHSA-7wch-p9px-956x",
        "GHSA-jc66-7q78-782g",
        "GHSA-8hrf-8g6f-7xwp",
        "GHSA-hqq3-7jhf-c5jx",
        "GHSA-5x38-2vff-x55p",
        "GHSA-6wvx-3r32-xmcg",
        "GHSA-525v-9gp9-w22h",
        "GHSA-5cwg-6vw7-rj6p"
      ]
    }
  },
  "simple-git-hooks": {
    "pre-commit": "bash ops/precommit.sh",
    "pre-push": "bash ops/prepush.sh"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
