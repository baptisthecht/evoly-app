# Evoly, fichier d'environnement de production. Copier en /opt/evoly/.env (ou lancer ops/new-env.sh, qui génère les secrets).
# Ne jamais versionner ce fichier une fois rempli. Valeurs sans espace ; « A_REMPLIR » bloque le premier démarrage.

# ===== Domaines =====
NEXT_PUBLIC_BASE_DOMAIN="evoly.me"
NEXT_PUBLIC_APP_URL="https://app.evoly.me"
NEXT_PUBLIC_SITE_URL="https://evoly.me"
NEXT_PUBLIC_SHORT_LINK_BASE="https://evoly.me"
BETTER_AUTH_URL="https://app.evoly.me"
CUSTOM_DOMAIN_TARGET="domains.evoly.me"
# adresse de contact de Let's Encrypt (avertissements sur les certificats)
ACME_EMAIL="A_REMPLIR"

# ===== Secrets (générés par ops/new-env.sh : openssl rand -hex 32) =====
POSTGRES_PASSWORD="A_REMPLIR"
BETTER_AUTH_SECRET="A_REMPLIR"
ORDER_TOKEN_SECRET="A_REMPLIR"
CRON_SECRET="A_REMPLIR"

# ===== E-mails (Resend) : indispensables (confirmation des comptes, billets) =====
RESEND_API_KEY="A_REMPLIR"
EMAIL_FROM_DOMAIN="evoly.me"
RESEND_WEBHOOK_SECRET=""
SUPPORT_EMAIL=""

# ===== Paiements (Stripe) : nécessaires pour les billets payants et l'offre Pro =====
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET_CONNECT=""
STRIPE_WEBHOOK_SECRET_PLATFORM=""
STRIPE_PRICE_PRO_MONTH=""
STRIPE_PRICE_PRO_YEAR=""
STRIPE_TAX_ENABLED="false"

# ===== Fichiers (Cloudflare R2, bucket public des images) : sinon, stockés sur le serveur =====
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# ===== Sauvegardes (bucket R2 PRIVÉ, distinct du précédent ; clé limitée à ce bucket) =====
BACKUP_R2_BUCKET="A_REMPLIR"
BACKUP_R2_ACCESS_KEY_ID="A_REMPLIR"
BACKUP_R2_SECRET_ACCESS_KEY="A_REMPLIR"

# ===== Mentions sur les relevés de commissions =====
EVOLY_LEGAL_NAME="Baptist Hecht - Evoly Solutions"
EVOLY_LEGAL_ADDRESS="Rue du Bilemont 376, 7700 Mouscron, Belgique"
# EVOLY_VAT_NUMBER="BE1043315766"  # à décommenter quand la TVA sera activée à la BCE

# ===== Facultatif : connexion Google et Apple =====
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# ===== Facultatif : Apple Wallet et Google Wallet (PEM encodés en base64 sur une ligne) =====
APPLE_PASS_TYPE_ID=""
APPLE_TEAM_ID=""
APPLE_PASS_CERT_PEM=""
APPLE_PASS_KEY_PEM=""
APPLE_PASS_KEY_PASSPHRASE=""
APPLE_WWDR_PEM=""
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_WALLET_PRIVATE_KEY=""

# Plan de salle d'après une photo (facultatif) : clé de l'API de Claude (console.anthropic.com), avec une limite de dépense
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5-5"

# Surveillance des tâches planifiées (Healthchecks.io, facultatif). Sans ces clés, rien n'est envoyé.
# Projet Healthchecks.io → Settings : « Ping key » et une clé d'API en lecture-écriture (« API keys »).
# Après les avoir renseignées : ops/healthchecks-setup.sh (crée les 8 sondes avec leurs horaires, une seule fois).
# HEALTHCHECKS_PING_KEY=""
# HEALTHCHECKS_API_KEY=""
