# Caddy : seul service ouvert sur Internet (ports 80 et 443).
{
	email {$ACME_EMAIL}
	# RG-DOM-03 : un certificat n'est délivré que si l'app reconnaît le domaine
	# (evoly.me, app., www., scanner., sous-domaines d'organisation et d'événement, domaines personnalisés actifs)
	on_demand_tls {
		ask http://app:3000/api/domains/allowed
	}
}

# Relais vers l'app : pendant une mise à jour, la nouvelle version démarre à côté de l'ancienne (ops/deploy.sh) ;
# si l'une ne répond pas, Caddy réessaie pendant 30 secondes au lieu d'afficher une erreur.
(app) {
	reverse_proxy app:3000 {
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

# Site vitrine et documents légaux (apps/web/dist) ; liens courts d'événement (/e/…) et de revente (/r/…) servis par l'app
{$SITE_DOMAIN} {
	encode zstd gzip
	# adresses devinées ou anciennes (« Introuvable (404) » dans la Search Console) : renvoyées vers la bonne page
	# le français est servi à la racine ; les prix sont une section de l'accueil
	redir /fr / permanent
	redir /fr/ / permanent
	@ancienFr path_regexp ancienFr ^/fr/(.+)$
	redir @ancienFr /{re.ancienFr.1} permanent
	redir /index.html / permanent
	redir /tarifs /#tarifs permanent
	redir /tarifs/ /#tarifs permanent
	@app path /e/* /r/*
	handle @app {
		import app
	}
	handle {
		root * /srv/web
		rewrite / /evoly-billetterie.html
		file_server
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# L'app : app., scanner., billetteries des organisations et des événements, domaines personnalisés
https:// {
	tls {
		on_demand
	}
	# l'app et le scanner ne sont pas faits pour Google (inscription, connexion, tableau de bord) ; les billetteries publiques restent indexables
	@private host app.{$SITE_DOMAIN} scanner.{$SITE_DOMAIN}
	header @private X-Robots-Tag "noindex, nofollow"
	encode zstd gzip
	# accès complet à la base (RG-ADM-01) : pgAdmin sur app.<domaine>/pgadmin, seulement si l'app confirme un administrateur Evoly
	# connecté avec sa double authentification ; sinon l'app renvoie vers la connexion, la double authentification, ou « introuvable »
	@pgadmin {
		host app.{$SITE_DOMAIN}
		path /pgadmin /pgadmin/*
	}
	handle @pgadmin {
		forward_auth app:3000 {
			uri /api/admin/acces-base
		}
		reverse_proxy pgadmin:80 {
			header_up X-Script-Name /pgadmin
		}
	}
	# Caddy transmet l'adresse réelle du visiteur (il ignore l'en-tête X-Forwarded-For envoyé par le client)
	handle {
		import app
	}
}

# Accès local au serveur (tâches planifiées, vérification du déploiement) : publié sur 127.0.0.1:3000 seulement, jamais sur Internet
http://:3000 {
	import app
}
